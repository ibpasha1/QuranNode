# Build output
build/
quran-sim
quran-dump
quran-loop-test
tools/.cache/

# Wi-Fi credentials — NEVER commit (see firmware/secrets.ini.example)
firmware/secrets.ini

# Firmware build output
firmware/.pio/
firmware/sdkconfig.devkit_st7796s
# NOTE: emb_*.c + embedded_assets.h (the no-SD Al-Fatihah fallback, ~1.8MB) ARE
# committed so the repo builds firmware with no external assets. Regenerate with
# tools/gen_embedded.py if the fallback content changes.

# Tooling venv + fonts (fonts are downloaded, not vendored)
tools/.venv/

# Generated preview/verification images
assets/preview/*.ppm
assets/preview/*.png

# SD-card content — generated by tools/ (packs, ~400MB+) or downloaded (audio) and
# lives on the physical card, NOT in git. The no-SD fallback is baked into emb_*.c.
sdcard/packs/
sdcard/audio/
sdcard/quran/
sdcard/state/

# OS cruft
.DS_Store
