; Template for firmware/secrets.ini (which is gitignored). Copy to secrets.ini
; and fill in your Wi-Fi network so the device can reach GitHub for OTA updates.
[secrets]
wifi =
    '-DWIFI_SSID="YOUR_WIFI_SSID"'
    '-DWIFI_PASS="YOUR_WIFI_PASSWORD"'

; Quran Teacher V2 scoring server (docs/TEACHER_V2.md). Leave empty for a
; pure-offline device; set to your Mac/server running server/app.py.
teacher =
    '-DTEACHER_URL="http://192.168.1.100:8090"'
